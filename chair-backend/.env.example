# ── Database ──────────────────────────────────────────────────────────────────
# Direct connection string — NOT the pooled endpoint
# Neon Console → your project → Connection Details → toggle to "Direct connection"
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# ── sqlx ──────────────────────────────────────────────────────────────────────
# Prevents sqlx from contacting the database at compile time
# Run `cargo sqlx prepare` once while the DB is reachable, then set this to true
SQLX_OFFLINE=true

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# ── Logging ───────────────────────────────────────────────────────────────────
RUST_LOG=chair_backend=debug,tower_http=debug

# ── Serial port ───────────────────────────────────────────────────────────────
# Comment this out entirely to run without Arduino hardware
# macOS:  /dev/cu.usbmodem14101  (run `ls /dev/cu.*` to find the exact name)
# Linux:  /dev/ttyACM0
# SERIAL_PORT=/dev/ttyACM0
