  "query": "\n        UPDATE presets\n        SET chair_angle_degrees = $3,\n            lumbar_heat         = $4,\n            upper_back_heat     = $5,\n            leg_heat            = $6,\n            light_mode          = $7,\n            light_color         = $8,\n            updated_at          = NOW()\n        WHERE machine_id = $1 AND name = $2\n        RETURNING id, machine_id, name, chair_angle_degrees,\n                  lumbar_heat, upper_back_heat, leg_heat,\n                  light_mode, light_color, times_loaded, created_at, updated_at\n        ",
